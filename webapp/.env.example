OPENROUTER_API_KEY=sk-or-...

# Optional per-agent model overrides (OpenRouter slugs). Omit to use the defaults in app/config.py.
# MODEL_CHAPTER_WRITER=anthropic/claude-opus-4.8
# MODEL_CHAPTER_SUMMARIZER=anthropic/claude-haiku-4.5

# Postgres. docker-compose already sets this and overrides whatever is here —
# you only need it for a bare local run (no Docker) against your own Postgres.
DATABASE_URL=postgresql+psycopg://novel:novel@localhost:5432/novelgen

# Poster art storage. Empty = keep art on local disk.
GCS_BUCKET=

# Login. Leave the passwords empty to disable auth entirely (everything open).
# AUTH_SECRET signs the session token — change it to invalidate every session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=
AUTH_SECRET=
